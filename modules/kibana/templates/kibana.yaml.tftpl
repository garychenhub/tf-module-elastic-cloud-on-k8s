apiVersion: kibana.k8s.elastic.co/v1
kind: Kibana
metadata:
  name: ${kibana_name}
  namespace: ${namespace}
spec:
  version: ${kibana_version}
%{ if kibana_image != null && kibana_image != "" ~}
  image: ${kibana_image}
%{ endif ~}
  count: ${replicas}
  elasticsearchRef:
    name: ${es_cluster_name}
%{ if es_namespace != null && es_namespace != namespace ~}
    namespace: ${es_namespace}
%{ endif ~}
%{ if resources.requests.memory != "1Gi" || resources.requests.cpu != "0.5" || resources.limits.memory != "2.5Gi" || resources.limits.cpu != "2" ~}
  podTemplate:
    spec:
      containers:
      - name: kibana
        resources:
          requests:
            cpu: ${resources.requests.cpu}
            memory: ${resources.requests.memory}
          limits:
            cpu: ${resources.limits.cpu}
            memory: ${resources.limits.memory}
%{ endif ~}
