apiVersion: elasticsearch.k8s.elastic.co/v1
kind: Elasticsearch
metadata:
  name: ${es_cluster_name}
  namespace: ${namespace}
spec:
  version: ${es_version}
%{ if es_image != null && es_image != "" ~}
  image: ${es_image}
%{ endif ~}
  volumeClaimDeletePolicy: ${volume_claim_delete_policy}
%{ if http != null ~}
  http:
%{ if http.service != null ~}
    service:
%{ if http.service.metadata != null ~}
      metadata:
%{ if lookup(http.service.metadata, "labels", null) != null && length(http.service.metadata.labels) > 0 ~}
        labels:
%{ for key, value in http.service.metadata.labels ~}
          ${key}: "${value}"
%{ endfor ~}
%{ endif ~}
%{ if lookup(http.service.metadata, "annotations", null) != null && length(http.service.metadata.annotations) > 0 ~}
        annotations:
%{ for key, value in http.service.metadata.annotations ~}
          ${key}: "${value}"
%{ endfor ~}
%{ endif ~}
%{ endif ~}
%{ if http.service.spec != null ~}
      spec:
%{ if http.service.spec.type != null ~}
        type: ${http.service.spec.type}
%{ endif ~}
%{ endif ~}
%{ endif ~}
%{ endif ~}
%{ if update_strategy != null ~}
  updateStrategy:
%{ if update_strategy.change_budget != null ~}
    changeBudget:
%{ if update_strategy.change_budget.max_surge != null ~}
      maxSurge: ${update_strategy.change_budget.max_surge}
%{ endif ~}
%{ if update_strategy.change_budget.max_unavailable != null ~}
      maxUnavailable: ${update_strategy.change_budget.max_unavailable}
%{ endif ~}
%{ endif ~}
%{ endif ~}
  nodeSets:
%{ for node_set in node_sets ~}
    - name: ${node_set.name}
      count: ${node_set.count}
      config:
%{ for key, value in merge(global_config, node_set.config) ~}
        ${key}: ${value}
%{ endfor ~}
%{ if node_set.storage != null && (node_set.storage.size != "" || node_set.storage.storage_class != "") ~}
      volumeClaimTemplates:
        - metadata:
            name: elasticsearch-data
          spec:
            accessModes:
              - ReadWriteOnce
            resources:
              requests:
                storage: ${node_set.storage.size}
%{ if node_set.storage.storage_class != "" ~}
            storageClassName: ${node_set.storage.storage_class}
%{ endif ~}
%{ endif ~}
      podTemplate:
        spec:
          containers:
            - name: elasticsearch
              imagePullPolicy: ${image_pull_policy}
%{ if node_set.resources.requests != null || node_set.resources.limits != null ~}
              resources:
%{ if node_set.resources.requests != null ~}
                requests:
%{ if node_set.resources.requests.memory != "" ~}
                  memory: ${node_set.resources.requests.memory}
%{ endif ~}
%{ if node_set.resources.requests.cpu != "" ~}
                  cpu: ${node_set.resources.requests.cpu}
%{ endif ~}
%{ endif ~}
%{ if node_set.resources.limits != null ~}
                limits:
%{ if node_set.resources.limits.memory != "" ~}
                  memory: ${node_set.resources.limits.memory}
%{ endif ~}
%{ if node_set.resources.limits.cpu != "" ~}
                  cpu: ${node_set.resources.limits.cpu}
%{ endif ~}
%{ endif ~}
%{ endif ~}
%{ endfor ~}
